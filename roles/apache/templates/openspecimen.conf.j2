# Managed by Ansible - do not edit by hand
# Proxy backend is {{ apache_proxy_protocol | upper }} ({{ apache_proxy_backend }}).
# When AJP is used, the Tomcat connector is bound to 127.0.0.1 (tomcat role),
# so it is never reachable off-box - mitigates CVE-2020-1938 (Ghostcat).
{# Bind non-default ports (distro already Listens on 80 and, with mod_ssl, 443);
   a second instance on e.g. 8443 needs its own Listen, but adding Listen 80/443
   again would be a duplicate-bind error. #}
{% if (apache_http_port | int) != 80 %}
Listen {{ apache_http_port }}
{% endif %}
{% if apache_enable_ssl and (apache_https_port | int) != 443 %}
Listen {{ apache_https_port }}
{% endif %}
{% if apache_enable_ssl %}
<VirtualHost *:{{ apache_http_port }}>
    ServerName {{ apache_server_name }}
    Redirect permanent / https://{{ apache_server_name }}{{ (':' ~ apache_https_port) if (apache_https_port | int) != 443 else '' }}/
</VirtualHost>

<VirtualHost *:{{ apache_https_port }}>
    ServerName {{ apache_server_name }}

    SSLEngine             on
    SSLCertificateFile    {{ apache_ssl_cert_file }}
    SSLCertificateKeyFile {{ apache_ssl_key_file }}
    SSLProtocol           all -TLSv1 -TLSv1.1
    SSLCipherSuite        HIGH:!aNULL:!MD5:!3DES
    SSLHonorCipherOrder   on

{% else %}
<VirtualHost *:{{ apache_http_port }}>
    ServerName {{ apache_server_name }}

{% endif %}
    # Serve static error pages directly - exclusions must precede the catch-all ProxyPass
    ProxyPass /downtime.html    !
    ProxyPass /OS_LOGO_BANNER.png !

    ProxyPreserveHost On
    ProxyPass        / {{ apache_proxy_backend }}
    ProxyPassReverse / {{ apache_proxy_backend }}
    ProxyPassReverseCookiePath /openspecimen/ /

{% if apache_security_headers %}
    Header always set X-Frame-Options        "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy        "strict-origin-when-cross-origin"
    Header always set Permissions-Policy     "accelerometer=(),autoplay=(),camera=(),encrypted-media=(),fullscreen=*,geolocation=(self),gyroscope=(),magnetometer=(),microphone=(),midi=(),payment=(),sync-xhr=(self),usb=(),xr-spatial-tracking=()"
{% if apache_enable_ssl %}
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
{% endif %}
{% endif %}

    ExpiresActive On
    ExpiresDefault "access plus 3 hours"

    ErrorDocument 503 /downtime.html

    ErrorLog  {{ _apache_log_dir }}/openspecimen-error.log
    CustomLog {{ _apache_log_dir }}/openspecimen-access.log combined

</VirtualHost>
