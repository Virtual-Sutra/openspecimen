# Managed by Ansible - do not edit by hand.
# DOMAIN routing mode (ADR-007): this instance answers on its OWN ServerName and is
# mounted at its context path ({{ apache_path_prefix }}), proxied 1:1 to its Tomcat
# ({{ apache_proxy_protocol | upper }} backend {{ apache_path_backend }}). Same mount
# path as path mode - the modes differ only in domain-vs-path, so app.url is identical
# either way. AJP is bound to 127.0.0.1 (mitigates CVE-2020-1938 Ghostcat). Instances
# route by distinct ServerName on 80/443, not custom ports.
{% if apache_enable_ssl %}
<VirtualHost *:{{ apache_http_port }}>
    ServerName {{ apache_server_name }}
    Redirect permanent / https://{{ apache_server_name }}/
</VirtualHost>

<VirtualHost *:{{ apache_https_port }}>
    ServerName {{ apache_server_name }}

    SSLEngine             on
    SSLCertificateFile    {{ apache_ssl_cert_file }}
    SSLCertificateKeyFile {{ apache_ssl_key_file }}
    SSLProtocol           all -TLSv1 -TLSv1.1
    SSLCipherSuite        HIGH:!aNULL:!MD5:!3DES
    SSLHonorCipherOrder   on

{% else %}
<VirtualHost *:{{ apache_http_port }}>
    ServerName {{ apache_server_name }}

{% endif %}
    # Serve static error pages directly - exclusions must precede the ProxyPass.
    ProxyPass /downtime.html    !
    ProxyPass /OS_LOGO_BANNER.png !

    ProxyPreserveHost On
    # DOMAIN mode serves the app at the host ROOT and HIDES the Tomcat context: '/'
    # proxies to this instance's Tomcat context (/{{ openspecimen_war_name }}, from the WAR
    # name = openspecimen_instance_name) and the session cookie path is rewritten back to
    # '/'. The backend context is the WAR context, NOT apache_path_prefix (which is the
    # PUBLIC mount and is '/' here). Public URL is https://{{ apache_server_name }}/ - set
    # openspecimen_app_url to the bare host. (PATH mode's mount lives in the path snippet.)
    ProxyPass        / {{ apache_path_backend }}/{{ openspecimen_war_name }}/
    ProxyPassReverse / {{ apache_path_backend }}/{{ openspecimen_war_name }}/
    ProxyPassReverseCookiePath /{{ openspecimen_war_name }} /

{% if apache_security_headers %}
    Header always set X-Frame-Options        "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy        "strict-origin-when-cross-origin"
    Header always set Permissions-Policy     "accelerometer=(),autoplay=(),camera=(),encrypted-media=(),fullscreen=*,geolocation=(self),gyroscope=(),magnetometer=(),microphone=(),midi=(),payment=(),sync-xhr=(self),usb=(),xr-spatial-tracking=()"
{% if apache_enable_ssl %}
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
{% endif %}
{% endif %}

    ExpiresActive On
    ExpiresDefault "access plus 3 hours"

    ErrorDocument 503 /downtime.html

    ErrorLog  {{ _apache_log_dir }}/{{ apache_vhost_name }}-error.log
    CustomLog {{ _apache_log_dir }}/{{ apache_vhost_name }}-access.log combined

</VirtualHost>
