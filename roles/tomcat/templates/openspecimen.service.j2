[Unit]
Description=OpenSpecimen (Tomcat)
{% if db_managed | default(true) %}
After=network.target {{ (ansible_facts['os_family'] == 'RedHat') | ternary('mysqld', 'mysql') }}.service
Requires={{ (ansible_facts['os_family'] == 'RedHat') | ternary('mysqld', 'mysql') }}.service
{% else %}
After=network.target
{% endif %}

[Service]
Type=forking
User={{ tomcat_user }}
Group={{ tomcat_user }}

# JAVA_HOME is written to /etc/environment by the java role (OS-aware path).
EnvironmentFile=/etc/environment
Environment=CATALINA_HOME={{ tomcat_home }}
Environment=CATALINA_BASE={{ tomcat_home }}
Environment=CATALINA_PID={{ tomcat_home }}/bin/pid.txt

ExecStart={{ tomcat_home }}/bin/startup.sh
ExecStop={{ tomcat_home }}/bin/shutdown.sh -force

SuccessExitStatus=143
TimeoutStartSec=120
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
