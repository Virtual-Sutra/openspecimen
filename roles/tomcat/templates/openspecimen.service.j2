[Unit]
Description=OpenSpecimen ({{ openspecimen_service_name | default('openspecimen') }})
{% if db_managed | default(true) %}
After=network.target {{ (ansible_facts['os_family'] == 'RedHat') | ternary('mysqld', 'mysql') }}.service
Requires={{ (ansible_facts['os_family'] == 'RedHat') | ternary('mysqld', 'mysql') }}.service
{% else %}
After=network.target
{% endif %}

[Service]
Type=forking
User={{ tomcat_user }}
Group={{ tomcat_user }}

# JAVA_HOME is written to /etc/environment by the java role (OS-aware path).
EnvironmentFile=/etc/environment
Environment=CATALINA_HOME={{ catalina_home | default(tomcat_home) }}
Environment=CATALINA_BASE={{ catalina_base }}
Environment=CATALINA_PID={{ catalina_base }}/bin/pid.txt

ExecStart={{ catalina_home | default(tomcat_home) }}/bin/startup.sh
ExecStop={{ catalina_home | default(tomcat_home) }}/bin/shutdown.sh -force

SuccessExitStatus=143
TimeoutStartSec=120
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
