# ── Direct / same-network inventory ──────────────────────────────────────────
# Use when Ansible can reach the target host directly over SSH
# (same network, VPN, or local VM).
#
# Copy to inventory/customers/<name>/hosts and fill in the values.
#
# Usage:
#   ansible-playbook -i inventory/customers/<name>/ site.yml
#
#   # site.yml auto-detects fresh vs upgrade. A normal upgrade is app-only
#   # (openspecimen/plugins/apache); base roles are skipped. Add
#   # -e force_deploy=true to force a full re-deploy of the entire stack.
#   ansible-playbook -i inventory/customers/<name>/ site.yml   # upgrade
# ─────────────────────────────────────────────────────────────────────────────

[openspecimen]
os-server  ansible_host=<IP_OR_HOSTNAME>  ansible_user=ubuntu

[all:vars]
ansible_python_interpreter   = /usr/bin/python3
ansible_ssh_private_key_file = ~/.ssh/your-key.pem
